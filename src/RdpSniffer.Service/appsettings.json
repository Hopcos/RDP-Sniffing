{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Warning"
    }
  },
  "RdpDetection": {
    "Network": "10.0.5.0/24",
    "ExcludedAddresses": [ "10.0.5.188" ],
    "MaxScanAddresses": 65536,
    "IncludeNetworkAddress": false,
    "IncludeBroadcastAddress": true,

    "Port": 3389,

    "VerifyCredentials": true,
    "Credentials": {
      "UserName": "xxx",
      "Password": "xxxxxx",
      "Domain": ""
    },
    "RequireRdpBanner": false,

    "ConnectTimeoutSeconds": 3,
    "HandshakeTimeoutSeconds": 3,
    "LoginTimeoutSeconds": 15,

    "MaxConcurrentProbes": 50,

    "RunOnStart": true,
    "RunContinuously": true,
    "ScanInterval": "00:10:00",

    "MstscPollingIntervalMilliseconds": 500,
    "MstscEnableCredSspSupport": true,
    "MstscAuthenticationLevel": 2,
    "LoginVerificationMethod": "Auto",

    "Report": {
      "Enabled": true,
      "FilePath": "rdp-scan-report.json"
    }
  }
}
