<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>RdpSniffer.Service</RootNamespace>
    <AssemblyName>RdpSniffer.Service</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RdpSniffer.Core\RdpSniffer.Core.csproj" />
    <ProjectReference Include="..\RdpSniffer.Probes.CredSsp\RdpSniffer.Probes.CredSsp.csproj" />
    <ProjectReference Include="..\RdpSniffer.Probes.Tcp\RdpSniffer.Probes.Tcp.csproj" />
    <ProjectReference Include="..\RdpSniffer.Probes.Mstsc\RdpSniffer.Probes.Mstsc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
